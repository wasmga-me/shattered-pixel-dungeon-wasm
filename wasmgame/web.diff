+	.replace(/"set_id":-?\d+/g, '"set_id":0')
+	.replace(/"(set_ids_enchants|set_ids)":\[[-\d,]*\]/g, (m, k) => `"${k}":${m.endsWith('[]') ? '[]' : '[0]'}`);
