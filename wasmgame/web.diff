@@ -0,0 +1,349 @@
+// WEB-PORT: browser build of Shattered Pixel Dungeon (libGDX + TeaVM through gdx-teavm).
+// Everything web-specific lives in this module; core and SPD-classes are consumed unchanged.
+
+import org.teavm.gradle.api.OptimizationLevel
+
+buildscript {
+    repositories {
+        mavenCentral()
+    }
+    dependencies {
+        classpath "com.github.xpenatan.gdx-teavm:gdx-teavm-plugin:$gdxTeaVMVersion"
+    }
+}
+
+apply plugin: 'java'
+apply plugin: 'com.github.xpenatan.gdx-teavm'
+
+[compileJava, compileTestJava]*.options*.encoding = 'UTF-8'
+// the TeaVM toolchain and gdx-teavm libraries require Java 17
+java.sourceCompatibility = java.targetCompatibility = JavaVersion.VERSION_17
+
+def mainClassName = 'com.shatteredpixel.shatteredpixeldungeon.html.WebLauncher'
+def coreAssets = new File(project(':core').projectDir, 'src/main/assets')
+def webDist = layout.buildDirectory.dir('dist/web')
+
+dependencies {
+    implementation project(':core')
+    implementation "com.badlogicgames.gdx:gdx-freetype:$gdxWebVersion"
+    // same version SPD-classes uses for Bundle; SeedCheck probes its number handling
+    implementation "org.json:json:20170516"
+    implementation "com.github.xpenatan.gdx-teavm:backend-web:$gdxTeaVMVersion"
+    implementation "com.github.xpenatan.gdx-teavm:gdx-freetype-web:$gdxTeaVMVersion"
+    implementation "com.github.xpenatan.gdx-teavm:gdx-controllers-web:$gdxTeaVMVersion"
+
+    // TeaVM compiler API, only used by the build-time reflection plugin (html.compiler.SPDReflection)
+    compileOnly "org.teavm:teavm-core:$teaVMVersion"
+    // shadowed TeaVM classlib classes (see html/src/main/java/org/teavm/classlib)
+    compileOnly "org.teavm:teavm-classlib:$teaVMVersion"
+    compileOnly "com.jcraft:jzlib:1.1.3"
+}
+
+// gdx-teavm's emulation layer is compiled against this libGDX release. The desktop/android builds keep
+// using the version from the root build.gradle; only the web classpath is aligned to the backend.
+configurations.matching { !it.name.startsWith('seedcheck') }.configureEach {
+    resolutionStrategy.eachDependency { details ->
+        if (details.requested.group == 'com.badlogicgames.gdx' && details.requested.name in ['gdx', 'gdx-freetype']) {
+            details.useVersion gdxWebVersion
+        }
+    }
+}
+
+// Version info, the equivalent of the manifest attributes DesktopLauncher reads.
+// -PwebDebug marks the build as INDEV (enables debug features, like desktop's 'debug' task)
+def buildConfigDir = layout.buildDirectory.dir('generated/sources/webBuildConfig')
+def webVersionName = appVersionName + (project.hasProperty('webDebug') ? '-INDEV' : '')
+tasks.register('generateWebBuildConfig') {
+    inputs.property('version', webVersionName)
+    inputs.property('code', appVersionCode)
+    outputs.dir(buildConfigDir)
+    doLast {
+        def f = buildConfigDir.get().file('com/shatteredpixel/shatteredpixeldungeon/html/WebBuildConfig.java').asFile
+        f.parentFile.mkdirs()
+        f.text = """package com.shatteredpixel.shatteredpixeldungeon.html;
+
+//generated by html/build.gradle
+public class WebBuildConfig {
+	public static final String VERSION = "${webVersionName}";
+	public static final int VERSION_CODE = ${appVersionCode};
+}
+"""
+    }
+}
+sourceSets.main.java.srcDir(buildConfigDir)
+compileJava.dependsOn 'generateWebBuildConfig'
+
+// ---------------------------------------------------------------------------------------------
+// Reflection metadata.
+// Bundle (save system) restores objects with Class.forName + newInstance, and the game creates
+// items/mobs/rooms/scenes/sprites/scripts from Class objects. TeaVM only keeps that metadata for
+// classes we list, so the list is generated from the compiled game code on every build:
+// every concrete class with a no-arg constructor that extends Bundlable, Gizmo or Script.
+// ---------------------------------------------------------------------------------------------
+def reflectionResDir = layout.buildDirectory.dir('generated/resources/webReflection')
+def reflectionList = reflectionResDir.map { it.file('spd-reflection-classes.txt') }
+// Nested classes of the game as the JVM sees them ("S name" = static member class, "M name" = inner class).
+// TeaVM loses the 'static' flag of nested classes, which Bundle relies on; the shadowed
+// emu ClassReflection in this module reads this table instead (shipped as an asset).
+def classInfoDir = layout.buildDirectory.dir('generated/web-class-info')
+def classInfoFile = classInfoDir.map { it.file('spd-class-info.txt') }
+
+tasks.register('generateReflectionList') {
+    description = 'Scans core/SPD-classes for classes that are instantiated reflectively'
+    def scanPath = configurations.runtimeClasspath
+    def gameDirs = files([project(':core'), project(':SPD-classes')].collect {
+        it.sourceSets.main.output.classesDirs
+    })
+    inputs.files(scanPath)
+    inputs.files(gameDirs)
+    outputs.file(reflectionList)
+    outputs.file(classInfoFile)
+    dependsOn ':core:classes', ':SPD-classes:classes'
+
+    doLast {
+        def urls = (gameDirs.files + scanPath.files).collect { it.toURI().toURL() } as URL[]
+        def loader = new URLClassLoader(urls, (ClassLoader) null)
+        def roots = ['com.watabou.utils.Bundlable', 'com.watabou.noosa.Gizmo', 'com.watabou.glscripts.Script']
+                .collect { Class.forName(it, false, loader) }
+
+        // java.lang.Class methods called explicitly: Groovy would otherwise prefer a game class's own
+        // static methods with the same name (e.g. a static getName())
+        def classMethod = { String m -> Class.class.getMethod(m) }
+        def nameOf = { Class k -> (String) classMethod('getName').invoke(k) }
+        def isMember = { Class k -> (boolean) classMethod('isMemberClass').invoke(k) }
+        def modifiersOf = { Class k -> (int) classMethod('getModifiers').invoke(k) }
+
+        def found = new TreeSet<String>()
+        def memberClasses = new TreeSet<String>()
+        gameDirs.files.each { File dir ->
+            if (!dir.exists()) return
+            dir.eachFileRecurse(groovy.io.FileType.FILES) { File f ->
+                if (!f.name.endsWith('.class')) return
+                def name = dir.toPath().relativize(f.toPath()).toString()
+                        .replace('\\', '.').replace('/', '.').replaceAll(/\.class$/, '')
+                if (name.endsWith('package-info') || name.endsWith('module-info')) return
+                Class c
+                try {
+                    c = Class.forName(name, false, loader)
+                } catch (Throwable ignored) {
+                    return
+                }
+                if (isMember(c)) {
+                    memberClasses << ((java.lang.reflect.Modifier.isStatic(modifiersOf(c)) ? 'S ' : 'M ') + nameOf(c))
+                }
+                if (c.isInterface() || java.lang.reflect.Modifier.isAbstract(c.getModifiers())) return
+                if (c.isAnonymousClass() || c.isLocalClass()) return
+                if (!roots.any { it.isAssignableFrom(c) }) return
+                // non-static inner classes can't be created reflectively by the game either
+                if (c.isMemberClass() && !java.lang.reflect.Modifier.isStatic(c.getModifiers())) return
+                try {
+                    c.getDeclaredConstructor()
+                } catch (NoSuchMethodException ignored) {
+                    return
+                }
+                found << nameOf(c)
+            }
+        }
+        def out = reflectionList.get().asFile
+        out.parentFile.mkdirs()
+        out.text = found.join('\n') + '\n'
+        logger.lifecycle("[web] reflection list: ${found.size()} classes -> ${out}")
+        def info = classInfoFile.get().asFile
+        info.parentFile.mkdirs()
+        info.text = memberClasses.join('\n') + '\n'
+        logger.lifecycle("[web] nested class table: ${memberClasses.size()} classes -> ${info}")
+    }
+}
+
+// the list is consumed at build time by SPDReflection (a TeaVM plugin in this module, see that class)
+sourceSets.main.resources.srcDir(reflectionResDir)
+processResources.dependsOn 'generateReflectionList'
+
+// Web asset folder: the game's assets, preloaded behind the loading screen.
+def webAssets = layout.buildDirectory.dir('web-assets')
+tasks.register('stageWebAssets', Sync) {
+    from(coreAssets) { exclude 'music/**' }
+    // the fallback font (CJK and system font option) ships with the desktop build, as on desktop
+    from(new File(project(':desktop').projectDir, 'src/main/assets')) { include 'fonts/**' }
+    // nested class table for ClassReflection, see generateReflectionList
+    from(classInfoDir)
+    dependsOn 'generateReflectionList'
+    into webAssets
+}
+
+// Music (~18MB ogg + ~18MB mp3) is not part of the preloaded manifest: WebAudioSupport downloads
+// a track when the game first plays it. The files are copied next to the other assets by 'dist'.
+def webMusic = layout.buildDirectory.dir('web-music')
+tasks.register('stageWebMusic', Sync) {
+    from(new File(coreAssets, 'music'))
+    // iOS ships mp3 copies of the ogg music; browsers without Vorbis support (Safari) use them
+    from(rootProject.file('ios/assets/music'))
+    into webMusic
+}
+
+gdxTeaVM {
+    assets(webAssets)
+
+
+    webDefaults {
+        mainClass.set(mainClassName)
+        htmlTitle.set(appName)
+        generateIndexHtml.set(false)
+        copyLoadingAsset.set(false)
+        // the game is large; TeaVM needs more heap than the Gradle daemon has
+        outOfProcess.set(true)
+        processMemory.set(4096)
+    }
+
+    js {
+        targetFileName.set('spd.js')
+        optimization.set(OptimizationLevel.BALANCED)
+        obfuscated.set(true)
+        sourceMap.set(false)
+        serverPort.set(8080)
+    }
+
+    js('debug') {
+        targetFileName.set('spd.js')
+        optimization.set(OptimizationLevel.NONE)
+        obfuscated.set(false)
+        sourceMap.set(true)
+        debugInformation.set(true)
+        serverPort.set(8081)
+    }
+}
+
+// Number formatting data (CLDR) for every language of the game. TeaVM only bundles en by default,
+// which made DecimalFormat/String.format ignore the locale (e.g. "1.5" instead of "1,5" in Russian).
+// Keep in sync with messages/Languages.java ("in" is the legacy code Java uses for Indonesian).
+def webLocales = ['en', 'zh', 'zh_Hant', 'ko', 'ru', 'es', 'pt', 'fr', 'de', 'ja', 'pl', 'it', 'tr', 'vi',
+                  'uk', 'id', 'cs', 'nl', 'sv', 'hu', 'el', 'be', 'eo']
+tasks.withType(org.teavm.gradle.tasks.TeaVMTask).configureEach {
+    properties.put('java.util.Locale.available', webLocales.join(', '))
+}
+
+tasks.matching { it.name.startsWith('gdx_teavm_') || it.name.startsWith('generateJavaScript') }.configureEach {
+    dependsOn 'generateReflectionList', 'stageWebAssets'
+}
+
+// ---------------------------------------------------------------------------------------------
+// Deployable static site.
+//   ./gradlew html:dist        -> html/build/dist/web (optimized, what CI deploys to Vercel)
+//   ./gradlew html:distDebug   -> html/build/dist/web-debug (unoptimized, readable stack traces)
+// Layout:
+//   index.html, manifest.webmanifest, icons/, LICENSE.txt      short cache
+//   b/<content hash>/{spd.js, scripts/, assets/}               immutable, cached forever
+// ---------------------------------------------------------------------------------------------
+def registerDist(String name, String teavmTask, String webappPath, String outPath) {
+    tasks.register(name) {
+        group = 'build'
+        description = "Assembles the static web site into ${outPath}"
+        dependsOn teavmTask, 'stageWebMusic'
+        def webapp = layout.buildDirectory.dir(webappPath)
+        def out = layout.buildDirectory.dir(outPath)
+        def music = layout.buildDirectory.dir('web-music')
+        def pageDir = file('webapp')
+        def icons = new File(project(':desktop').projectDir, 'src/main/assets/icons')
+        def license = rootProject.file('LICENSE.txt')
+        inputs.dir(webapp)
+        inputs.dir(music)
+        inputs.dir(pageDir)
+        outputs.dir(out)
+
+        doLast {
+            def src = webapp.get().asFile
+            def dst = out.get().asFile
+            project.delete(dst)
+
+            def payload = [] as List<File>
+            payload << new File(src, 'spd.js')
+            ['scripts', 'assets'].each { d -> new File(src, d).eachFileRecurse(groovy.io.FileType.FILES) { payload << it } }
+            music.get().asFile.eachFile(groovy.io.FileType.FILES) { payload << it }
+
+            def md = java.security.MessageDigest.getInstance('SHA-256')
+            payload.sort { it.absolutePath }.each { f ->
+                md.update(f.name.getBytes('UTF-8'))
+                f.withInputStream { is ->
+                    byte[] buf = new byte[65536]
+                    int n
+                    while ((n = is.read(buf)) > 0) md.update(buf, 0, n)
+                }
+            }
+            def hash = md.digest().encodeHex().toString().substring(0, 12)
+            def base = "b/${hash}/"
+
+            project.copy {
+                from(src) {
+                    include 'spd.js', 'scripts/**', 'assets/**'
+                }
+                into new File(dst, base)
+            }
+            project.copy {
+                from music
+                into new File(dst, base + 'assets/music')
+            }
+            project.copy {
+                from(pageDir) { exclude 'index.html' }
+                into dst
+            }
+            project.copy {
+                from(icons) { include '*.png' }
+                into new File(dst, 'icons')
+            }
+            project.copy {
+                from license
+                into dst
+            }
+            new File(dst, 'index.html').setText(
+                    new File(pageDir, 'index.html').getText('UTF-8').replace('%BUILD_BASE%', base), 'UTF-8')
+
+            logger.lifecycle("[web] site assembled in ${dst} (build ${hash})")
+        }
+    }
+}
+
+registerDist('dist', 'gdx_teavm_web_js_build', 'dist/js/webapp', 'dist/web')
+registerDist('distDebug', 'gdx_teavm_web_js_debug_build', 'dist/js/debug/webapp', 'dist/web-debug')
+
+// so that './gradlew html:build' also produces the site
+build.dependsOn 'dist'
+
+// ---------------------------------------------------------------------------------------------
+// 1:1 check of level generation: the same SeedCheck code is run on the JVM with the desktop
+// build's libGDX version, and in the browser with ?seedcheck=SEED (see README).
+//   ./gradlew html:seedCheckDesktop -Pseed=ABC-DEF-GHI,JKL-MNO-PQR -Phero=warrior,mage -Pdepths=5
+// writes html/build/seedcheck/desktop.txt, compare with the page's output (see README)
+// ---------------------------------------------------------------------------------------------
+sourceSets {
+    seedcheck {
+        java.srcDir 'src/seedcheck/java'
+        compileClasspath += sourceSets.main.output
+        runtimeClasspath += sourceSets.main.output
+    }
+}
+dependencies {
+    seedcheckImplementation project(':core')
+    seedcheckImplementation "com.badlogicgames.gdx:gdx-backend-headless:$gdxVersion"
+    seedcheckImplementation "com.badlogicgames.gdx:gdx-platform:$gdxVersion:natives-desktop"
+    seedcheckImplementation "com.badlogicgames.gdx:gdx-freetype:$gdxVersion"
+}
+tasks.register('seedCheckDesktop', JavaExec) {
+    group = 'verification'
+    description = 'Dumps generated floors for a seed using the desktop (JVM) game code'
+    dependsOn 'stageWebAssets'
+    classpath = sourceSets.seedcheck.runtimeClasspath
+    mainClass = 'com.shatteredpixel.shatteredpixeldungeon.html.seedcheck.SeedCheckDesktop'
+    def seed = project.findProperty('seed') ?: 'AAA-AAA-AAA'
+    def hero = project.findProperty('hero') ?: 'warrior'
+    def depths = project.findProperty('depths') ?: '5'
+    workingDir = webAssets.get().asFile
+    systemProperty 'spd.version', appVersionName
+    systemProperty 'spd.versionCode', appVersionCode
+    args seed, hero, depths, layout.buildDirectory.file('seedcheck/desktop.txt').get().asFile.absolutePath
+}
+
+// TeaVM doesn't clear its output folder, so files removed from the assets would linger in later builds
+tasks.matching { it.name in ['generateJavaScript', 'gdx_teavm_web_js_debug_compile'] }.configureEach { task ->
+    def dir = layout.buildDirectory.dir(task.name.contains('debug') ? 'dist/js/debug/webapp' : 'dist/js/webapp')
+    doFirst { project.delete(dir) }
+}
