+    @Override
+    public StringBuffer format(Object object, StringBuffer buffer, TFieldPosition field) {
+        if (object instanceof BigDecimal) {
+            return format((BigDecimal) object, buffer, field);
+        } else if (object instanceof BigInteger) {
+            return format((BigInteger) object, buffer, field);
+        } else {
+            return super.format(object, buffer, field);
+        }
+    }
+
+    private StringBuffer format(BigInteger value, StringBuffer buffer, TFieldPosition field) {
+        return format(new BigDecimal(value), buffer, field);
+    }
+
+    private StringBuffer format(BigDecimal value, StringBuffer buffer,
+            @SuppressWarnings("unused") TFieldPosition field) {
+        if (exponentDigits > 0) {
+            formatExponent(value, buffer);
+        } else {
+            formatRegularJdk(value.abs(), value.signum() < 0, buffer); // WEB-PORT
+        }
+        return buffer;
+    }
+
+    @Override
+    public StringBuffer format(long value, StringBuffer buffer, TFieldPosition field) {
+        if (exponentDigits > 0) {
+            formatExponent(value, buffer);
+        } else {
+            BigDecimal decimal = BigDecimal.valueOf(value); // WEB-PORT
+            formatRegularJdk(decimal.abs(), value < 0, buffer);
+        }
+        return buffer;
+    }
+
+    @Override
+    public StringBuffer format(double value, StringBuffer buffer, TFieldPosition field) {
+        if (Double.isNaN(value)) {
+            fieldsToText(positivePrefix, buffer).append(symbols.getNaN());
+            appendSuffix(true, buffer);
+        } else if (Double.isInfinite(value)) {
+            fieldsToText(value > 0 ? positivePrefix : negativePrefix, buffer).append(symbols.getInfinity());
+            appendSuffix(value > 0, buffer);
+        } else {
+            if (exponentDigits > 0) {
+                DoubleAnalyzer.Result analysisResult = Constants.doubleAnalysisResult;
+                DoubleAnalyzer.analyze(value, analysisResult);
+                formatExponent(analysisResult.mantissa, analysisResult.exponent, !analysisResult.sign, buffer);
+            } else {
+                // WEB-PORT: like the JDK, round the exact binary value (new BigDecimal(double) is exact)
+                boolean negative = value < 0 || (value == 0 && 1 / value < 0);
+                formatRegularJdk(new BigDecimal(Math.abs(value)), negative, buffer);
+            }
+        }
+        return buffer;
+    }
+
+    // WEB-PORT: non-exponential formatting with java.text.DecimalFormat semantics (see the class comment)
+    private void formatRegularJdk(BigDecimal value, boolean negative, StringBuffer buffer) {
+        if (multiplier != 1) {
+            value = value.multiply(BigDecimal.valueOf(multiplier));
+        }
+        int maxFrac = Math.max(0, getMaximumFractionDigits());
+        int minFrac = Math.max(0, Math.min(getMinimumFractionDigits(), maxFrac));
+        value = value.setScale(maxFrac, getRoundingMode());
+
+        String digits = value.unscaledValue().toString();
+        String intDigits;
+        String fracDigits;
+        if (maxFrac == 0) {
+            intDigits = digits;
+            fracDigits = "";
+        } else if (digits.length() > maxFrac) {
+            intDigits = digits.substring(0, digits.length() - maxFrac);
+            fracDigits = digits.substring(digits.length() - maxFrac);
+        } else {
+            StringBuilder padded = new StringBuilder();
+            for (int i = digits.length(); i < maxFrac; ++i) {
+                padded.append('0');
+            }
+            intDigits = "";
+            fracDigits = padded.append(digits).toString();
+        }
+        // significant integer digits only
+        int firstNonZero = 0;
+        while (firstNonZero < intDigits.length() && intDigits.charAt(firstNonZero) == '0') {
+            ++firstNonZero;
+        }
+        intDigits = intDigits.substring(firstNonZero);
+        // the JDK keeps only the lowest maximumIntegerDigits digits
+        int maxInt = getMaximumIntegerDigits();
+        if (intDigits.length() > maxInt) {
+            intDigits = intDigits.substring(intDigits.length() - maxInt);
+        }
+        // drop trailing fraction zeros beyond the minimum
+        int fracLength = fracDigits.length();
+        while (fracLength > minFrac && fracDigits.charAt(fracLength - 1) == '0') {
+            --fracLength;
+        }
+        fracDigits = fracDigits.substring(0, fracLength);
+
+        fieldsToText(negative ? negativePrefix : positivePrefix, buffer);
+        int sizeBeforeIntegerPart = buffer.length();
+
+        int intCount = Math.max(intDigits.length(), getMinimumIntegerDigits());
+        boolean grouping = isGroupingUsed() && groupingSize > 0;
+        for (int i = intCount - 1; i >= 0; --i) {
+            int index = intDigits.length() - 1 - i;
+            int digit = index >= 0 ? intDigits.charAt(index) - '0' : 0;
+            buffer.append(forDigit(digit));
+            if (grouping && i > 0 && i % groupingSize == 0) {
+                buffer.append(symbols.getGroupingSeparator());
+            }
+        }
+
+        boolean fractionPresent = fracDigits.length() > 0;
+        // as in the JDK: if there is no fraction and no integer digit was printed, print a zero
+        if (!fractionPresent && buffer.length() == sizeBeforeIntegerPart) {
+            buffer.append(forDigit(0));
+        }
+        if (fractionPresent || isDecimalSeparatorAlwaysShown()) {
+            buffer.append(symbols.getDecimalSeparator());
+        }
+        for (int i = 0; i < fracDigits.length(); ++i) {
+            buffer.append(forDigit(fracDigits.charAt(i) - '0'));
+        }
+
+        appendSuffix(!negative, buffer);
+    }
