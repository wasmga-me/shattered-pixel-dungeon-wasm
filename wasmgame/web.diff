+
+const canon = (v) => {
+	if (Array.isArray(v)) {
+		const items = v.map(canon);
+		return '[' + (v.length && typeof v[0] === 'object' ? items.sort() : items).join(',') + ']';
+	}
+	if (v && typeof v === 'object') {
+		return '{' + Object.keys(v).sort().map((k) => JSON.stringify(k) + ':' + canon(v[k])).join(',') + '}';
+	}
